# ─── Voice service configuration ───
# Copy to .env and adjust. All values have sensible defaults.

# HTTP
HOST=0.0.0.0
PORT=8000

# ─── STT (speech-to-text) ───
# Vietnamese Zipformer (transducer) — the `nghi-stt-v3` model served by the
# live nghitts.app web app. The model dir must contain: encoder*.onnx,
# decoder*.onnx, joiner*.onnx, tokens.txt (file names are auto-detected).
# Run `python scripts/download_models.py` to fetch + extract them automatically.
STT_MODEL_NAME=nghi-stt-v3
# CPU threads for inference.
STT_NUM_THREADS=4
# Where the STT model files live (relative to project root).
STT_MODEL_DIR=models/stt
# Silero VAD model (auto-downloaded by scripts/download_models.py).
VAD_MODEL=models/vad/silero_vad.onnx

# ─── TTS (text-to-speech, VieNeu) ───
# Default voice. Any v3 Turbo preset: Adam, Phạm Tuyên, Xuân Vĩnh, Thùy Dung…
TTS_DEFAULT_VOICE=Adam
# Pre-configured quick-pick voices (one male, one female) shown as one-tap
# buttons in the UI. Any v3 Turbo preset name works.
TTS_DEFAULT_VOICE_MALE=Adam
TTS_DEFAULT_VOICE_FEMALE=Ngọc Huyền

# ─── AI (the consultant) ───
# The voice flow sends the transcript to this endpoint and reads `answer`.
# Default points at the ChatbotAIAgent backend's public customer chat.
AI_CHAT_URL=http://localhost:8002/v1/customer/chat
AI_TIMEOUT_SECONDS=60
